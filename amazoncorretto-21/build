#!/bin/bash

#
# Fail on any errors.
#
set -e

#
# Pick up global versions.
#
. ../VERSIONS

# Ensure availability of correct Maven version.
(cd ../maven; ./fetch $@)

docker buildx build $@ -t shibboleth-build-docker:amazon21 \
    --build-arg MAVEN_IMAGE=${MAVEN_IMAGE} \
    --build-arg MAVEN_VERSION=${MAVEN_VERSION} \
    --build-context common=../contexts/common \
    .
