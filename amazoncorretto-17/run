#!/bin/bash

SUPPORT_DIR=${SUPPORT_DIR:-"${HOME}/Dev/Git/Shib/java-release-support"}

if [ -z "$RELEASE_ID" ]; then
    RELEASE_ID=$(date +%Y%m%d_%H%M)
fi
RELEASE_VOLUME="release-${RELEASE_ID}"
docker volume ls | grep $RELEASE_VOLUME || docker volume create $RELEASE_VOLUME

# Tag for the image variant we are using
TAG=amazon17

#
# Docker Desktop for Mac: Mount the magic volume to forward the ssh-agent.
#
MAC_OPTIONS=
if [[ "$OSTYPE" =~ ^darwin ]]; then
    if [ -n "$SSH_AUTH_SOCK" ]; then
        MAC_OPTIONS="-v /run/host-services/ssh-auth.sock:/run/host-services/ssh-auth.sock"
    fi
fi

docker run -i -t --rm --name shibboleth-build-17 --hostname ${TAG} \
    --volume=${PWD}/user:/home/user \
    --mount type=bind,src=${SUPPORT_DIR},dst=/home/user/release-support,ro \
    --mount type=volume,src=${RELEASE_VOLUME},dst=/home/user/release \
    $MAC_OPTIONS \
    $@ \
    shibboleth-build-docker:${TAG}
