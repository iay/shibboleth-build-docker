#!/bin/bash

#
# Fail on any errors.
#
set -e

# Tag for the image variant we are using
TAG=amazon11

#
# Pick up global versions.
#
. ../VERSIONS

# Ensure availability of correct Maven version.
(cd ../maven; ./fetch $@)

docker buildx build $@ \
    --platform=linux/amd64,linux/arm64 \
    --build-arg MAVEN_IMAGE=${MAVEN_IMAGE} \
    --build-arg MAVEN_VERSION=${MAVEN_VERSION} \
    --push \
    --tag ianayoung/shibboleth-build-docker:${TAG} \
    .
